# ============================================================================
# ResumePilot MCP — Example environment configuration
#
# Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
#
# SECURITY: `.env` is git-ignored. NEVER put real passwords, OTPs, session
# cookies, or OAuth tokens for LinkedIn / Naukri / Indeed / email into this
# repo. ResumePilot never stores third-party account passwords or OTPs.
# Credentials for future integrations belong in your OS secret store or in a
# `.env` that stays on your machine only.
# ============================================================================

# ----------------------------------------------------------------------------
# Storage
# ----------------------------------------------------------------------------
# Root directory where ResumePilot keeps your data: the SQLite tracking DB,
# the immutable master resume, per-application resume versions, and reports.
# Defaults to `./data` inside the project if unset.
RESUMEPILOT_DATA_DIR=./data

# SQLite database filename (created inside RESUMEPILOT_DATA_DIR).
RESUMEPILOT_DB_FILE=resumepilot.sqlite

# ----------------------------------------------------------------------------
# ATS / optimization tuning (Phase 1)
# ----------------------------------------------------------------------------
# Target ATS score the optimizer aims for. NOT guaranteed — the optimizer will
# never keyword-stuff or invent content to hit it.
ATS_TARGET_SCORE=90

# Minimum overall match score (0-100) for a job to be recommended for applying.
MATCH_SCORE_THRESHOLD=60

# ----------------------------------------------------------------------------
# Job search / worker concurrency (Phase 2+ — defined now, used later)
# ----------------------------------------------------------------------------
# Max number of jobs analyzed per run.
JOB_SEARCH_MAX_JOBS=1000

# Number of concurrent search/analysis workers. Increase carefully. Respect
# each job source's rate limits, robots/terms, and anti-bot protections.
JOB_SEARCH_CONCURRENCY=10

# ----------------------------------------------------------------------------
# Logging
# ----------------------------------------------------------------------------
# error | warn | info | debug
RESUMEPILOT_LOG_LEVEL=info

# ----------------------------------------------------------------------------
# Future integrations (Phase 3-5) — leave blank in Phase 1.
# These are placeholders documenting what WILL be wired via OAuth/official
# flows. Do not paste passwords here.
# ----------------------------------------------------------------------------
# GMAIL_OAUTH_CLIENT_ID=
# GMAIL_OAUTH_CLIENT_SECRET=
# LINKEDIN_OAUTH_CLIENT_ID=
# LINKEDIN_OAUTH_CLIENT_SECRET=
